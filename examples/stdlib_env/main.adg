# Environment Variables Test Example

import [Env] from "std/std.adg";

extern printf(fmt: string, ...) ret int;

frame main() ret int {
    printf("=== Environment Variables Test ===\n\n");

    # Set test environment variables
    printf("--- Set Variables ---\n");
    local setResult: bool = Env.set("ADGLANG_TEST_VAR", "hello_world");
    printf("Set ADGLANG_TEST_VAR=hello_world: %d\n", cast<int>(setResult));

    Env.set("ADGLANG_TEST_INT", "42");
    printf("Set ADGLANG_TEST_INT=42\n");

    Env.set("ADGLANG_TEST_BOOL_TRUE", "true");
    Env.set("ADGLANG_TEST_BOOL_FALSE", "false");
    Env.set("ADGLANG_TEST_BOOL_ONE", "1");
    Env.set("ADGLANG_TEST_BOOL_ZERO", "0");
    printf("Set ADGLANG_TEST_BOOL_* variables\n");

    # Get variables
    printf("\n--- Get Variables ---\n");
    local val: *char = Env.get("ADGLANG_TEST_VAR");
    if (val != nullptr) {
        printf("ADGLANG_TEST_VAR = %s\n", val);
    } else {
        printf("ADGLANG_TEST_VAR not found\n");
    }

    local intVal: *char = Env.get("ADGLANG_TEST_INT");
    if (intVal != nullptr) {
        printf("ADGLANG_TEST_INT = %s\n", intVal);
    }
    # Get with default
    printf("\n--- Get With Default ---\n");
    local existing: *char = Env.getOr("ADGLANG_TEST_VAR", "default");
    printf("getOr(ADGLANG_TEST_VAR, default) = %s\n", existing);

    local nonExisting: *char = Env.getOr("ADGLANG_NONEXISTENT_VAR", "my_default");
    printf("getOr(ADGLANG_NONEXISTENT_VAR, default) = %s\n", nonExisting);

    # Has checks
    printf("\n--- Has Checks ---\n");
    printf("has(ADGLANG_TEST_VAR): %d\n", cast<int>(Env.has("ADGLANG_TEST_VAR")));
    printf("has(ADGLANG_NONEXISTENT): %d\n", cast<int>(Env.has("ADGLANG_NONEXISTENT")));

    # Integer parsing
    printf("\n--- Integer Parsing ---\n");
    local parsedInt: int = Env.getInt("ADGLANG_TEST_INT", -1);
    printf("getInt(ADGLANG_TEST_INT, -1) = %d\n", parsedInt);

    local defaultInt: int = Env.getInt("ADGLANG_NONEXISTENT", 999);
    printf("getInt(ADGLANG_NONEXISTENT, 999) = %d\n", defaultInt);

    # Boolean parsing
    printf("\n--- Boolean Parsing ---\n");
    local boolTrue: bool = Env.getBool("ADGLANG_TEST_BOOL_TRUE", false);
    printf("getBool(ADGLANG_TEST_BOOL_TRUE): %d\n", cast<int>(boolTrue));

    local boolFalse: bool = Env.getBool("ADGLANG_TEST_BOOL_FALSE", true);
    printf("getBool(ADGLANG_TEST_BOOL_FALSE): %d\n", cast<int>(boolFalse));

    local boolOne: bool = Env.getBool("ADGLANG_TEST_BOOL_ONE", false);
    printf("getBool(ADGLANG_TEST_BOOL_ONE): %d\n", cast<int>(boolOne));

    local boolZero: bool = Env.getBool("ADGLANG_TEST_BOOL_ZERO", true);
    printf("getBool(ADGLANG_TEST_BOOL_ZERO): %d\n", cast<int>(boolZero));

    local boolDefault: bool = Env.getBool("ADGLANG_NONEXISTENT", true);
    printf("getBool(ADGLANG_NONEXISTENT, true): %d\n", cast<int>(boolDefault));

    # Set if absent
    printf("\n--- Set If Absent ---\n");
    local setNew: bool = Env.setIfAbsent("ADGLANG_NEW_VAR", "new_value");
    printf("setIfAbsent(ADGLANG_NEW_VAR): %d (set new var)\n", cast<int>(setNew));

    local setExisting: bool = Env.setIfAbsent("ADGLANG_TEST_VAR", "other_value");
    printf("setIfAbsent(ADGLANG_TEST_VAR): %d (already exists, no change)\n", cast<int>(setExisting));

    local newVal: *char = Env.get("ADGLANG_NEW_VAR");
    if (newVal != nullptr) {
        printf("ADGLANG_NEW_VAR = %s\n", newVal);
    }
    # Verify existing wasn't changed
    local unchangedVal: *char = Env.get("ADGLANG_TEST_VAR");
    if (unchangedVal != nullptr) {
        printf("ADGLANG_TEST_VAR unchanged = %s\n", unchangedVal);
    }
    # Unset
    printf("\n--- Unset ---\n");
    printf("has(ADGLANG_NEW_VAR) before unset: %d\n", cast<int>(Env.has("ADGLANG_NEW_VAR")));
    Env.unset("ADGLANG_NEW_VAR");
    printf("has(ADGLANG_NEW_VAR) after unset: %d\n", cast<int>(Env.has("ADGLANG_NEW_VAR")));

    # System paths (these may vary but should not crash)
    printf("\n--- System Paths ---\n");
    local path: *char = Env.getPath();
    if (path != nullptr) {
        printf("PATH exists: 1\n");
    } else {
        printf("PATH exists: 0\n");
    }

    local home: *char = Env.getHome();
    if (home != nullptr) {
        printf("HOME exists: 1\n");
    } else {
        printf("HOME exists: 0\n");
    }

    local tmpDir: *char = Env.getTmpDir();
    printf("TmpDir = %s\n", tmpDir);

    # Cleanup test variables
    printf("\n--- Cleanup ---\n");
    Env.unset("ADGLANG_TEST_VAR");
    Env.unset("ADGLANG_TEST_INT");
    Env.unset("ADGLANG_TEST_BOOL_TRUE");
    Env.unset("ADGLANG_TEST_BOOL_FALSE");
    Env.unset("ADGLANG_TEST_BOOL_ONE");
    Env.unset("ADGLANG_TEST_BOOL_ZERO");
    printf("Test variables cleaned up\n");

    printf("\n=== Environment Variables Test Complete ===\n");
    return 0;
}
