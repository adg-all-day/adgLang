{
  "name": "adgLang-v3",
  "version": "0.4.0",
  "description": "A transpiler for the ADGLANG programming language targeting LLVM IR.",
  "main": "index.ts",
  "bin": {
    "adgLang": "./adgLang"
  },
  "scripts": {
    "start": "bun index.ts",
    "build": "bun run build:runtime && bun run build:compiler",
    "build:runtime": "cd lib && ./build_runtime.sh",
    "build:compiler": "bun build --compile --outfile=adgLang ./index.ts",
    "check": "bunx tsc --noEmit --lib ESNext",
    "lint": "eslint compiler/ vscode-ext/src/ index.ts",
    "lint:fix": "eslint compiler/ vscode-ext/src/ index.ts --fix",
    "test": "bun test tests/",
    "test:baseline": "bun test 2>&1 | tee test-baseline.txt",
    "format": "prettier -u --write *",
    "format-examples": "bun index.ts format -w **/**/*.adg",
    "playground": "cd playground &&bash ./start.sh",
    "file-sizes": "wc -l compiler/**/*.ts compiler/**/**/*.ts index.ts vscode-ext/src/*.ts 2>/dev/null | sort -n | tail -20"
  },
  "keywords": [
    "compiler",
    "transpiler",
    "llvm",
    "adgLang",
    "language"
  ],
  "author": "Tomiwa Adeaga <owooluwabori@gmail.com> (tomadeaga@gmail.com)",
  "license": "Apache-2.0",
  "type": "commonjs",
  "private": false,
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "^9.39.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "peggy": "^5.0.6"
  }
}
